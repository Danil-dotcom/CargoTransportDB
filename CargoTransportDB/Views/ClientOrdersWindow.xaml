<Window x:Class="CargoTransportation.Views.ClientOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📋 Мои заказы" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🚚 Грузоперевозки" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Grid.Column="1" x:Name="WelcomeText" FontSize="16" Foreground="#7F8C8D" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="➕ Новый заказ" Click="NewOrderButton_Click" 
                        Width="120" Height="35" Background="#3498DB" Foreground="White"/>
            </Grid>
        </Border>

        <!-- Заголовок -->
        <TextBlock Grid.Row="1" Text="📋 Мои заказы" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <!-- Список заказов -->
        <DataGrid x:Name="OrdersDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="White" AlternatingRowBackground="#F9F9F9"
                  FontSize="13" SelectionChanged="OrdersDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ заказа" Binding="{Binding OrderNumber}" Width="110"/>
                <DataGridTextColumn Header="Откуда" Binding="{Binding PickupAddress}" Width="200"/>
                <DataGridTextColumn Header="Куда" Binding="{Binding DeliveryAddress}" Width="200"/>
                <DataGridTextColumn Header="Груз" Binding="{Binding Cargo.Name}" Width="130"/>
                <DataGridTextColumn Header="Транспорт" Binding="{Binding Vehicle.PlateNumber}" Width="110"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=' {0:C}'}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status.StatusName}" Width="100"/>
                <DataGridTemplateColumn Header="Действия" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Подробнее" Tag="{Binding OrderID}" Click="ViewOrderDetails_Click" 
                                        Width="80" Margin="2" Background="#3498DB" Foreground="White"/>
                                <Button Content="📑 PDF" Tag="{Binding OrderID}" Click="DownloadPDF_Click" 
                                        Width="60" Margin="2" Background="#E67E22" Foreground="White"/>
                                <Button Content="🗑 Удалить" Tag="{Binding OrderID}" Click="DeleteOrder_Click" 
                                        Width="70" Margin="2" Background="#E74C3C" Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Если нет заказов -->
        <TextBlock x:Name="NoOrdersText" Grid.Row="2" Text="📭 У вас пока нет заказов. Нажмите 'Новый заказ'" 
                   FontSize="14" Foreground="#95A5A6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

        <!-- Кнопка выхода -->
        <Button Grid.Row="3" Content="🚪 Выйти" Click="LogoutButton_Click" 
                Width="100" Height="35" Margin="0,15,0,0"
                Background="#95A5A6" Foreground="White" HorizontalAlignment="Right"/>
    </Grid>
</Window>