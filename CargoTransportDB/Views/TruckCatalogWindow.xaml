<Window x:Class="CargoTransportation.Views.TruckCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🚛 Каталог грузовиков" Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🚛 Каталог грузовиков" 
                   FontSize="28" FontWeight="Bold" Foreground="#2C3E50"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Выберите грузовик для оформления заказа" 
                   FontSize="14" Foreground="#7F8C8D"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TrucksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="15" Margin="0,0,0,15" Padding="15"
                                BorderBrush="#BDC3C7" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="18" FontWeight="Bold">
                                        <Run Text="{Binding Brand}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Model}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#7F8C8D" Margin="0,5,0,0">
                                        <Run Text="📋 Госномер: "/><Run Text="{Binding PlateNumber}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#7F8C8D">
                                        <Run Text="⚖️ Грузоподъемность: "/><Run Text="{Binding LoadCapacity}"/><Run Text=" кг"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#7F8C8D">
                                        <Run Text="📅 Год выпуска: "/><Run Text="{Binding Year}"/>
                                    </TextBlock>
                                    <Border CornerRadius="15" Padding="10,5" Margin="0,10,0,0" Width="100"
                                            Background="#27AE60">
                                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="1" Content="✅ Выбрать" 
                                        Tag="{Binding VehicleID}"
                                        Click="SelectTruck_Click"
                                        Width="120" Height="40"
                                        Background="#27AE60" Foreground="White"
                                        FontSize="14" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3" Content="🚪 Выйти" Click="LogoutButton_Click" 
                Width="120" Height="40" Margin="0,20,0,0"
                Background="#95A5A6" Foreground="White" HorizontalAlignment="Center"/>
    </Grid>
</Window>