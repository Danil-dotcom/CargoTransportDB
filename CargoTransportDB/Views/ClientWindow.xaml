<Window x:Class="CargoTransportation.Views.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный кабинет клиента" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="White" Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🚚" FontSize="32"/>
                    <TextBlock Text="Грузоперевозки" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="👋" FontSize="24"/>
                    <TextBlock x:Name="WelcomeText" FontSize="18" Foreground="#2C3E50" Margin="10,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Выйти" Background="#E74C3C" Foreground="White" 
                        Click="LogoutButton_Click" Width="100" Height="35" Margin="5"/>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- Заголовок формы -->
                <TextBlock Text="📝 Оформление нового заказа" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                <!-- Форма заказа -->
                <Border Background="White" CornerRadius="15" Padding="25" Margin="0,0,0,30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая колонка -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="📍 Информация о перевозке" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                                <TextBlock Text="Адрес погрузки" Foreground="#7F8C8D" Margin="0,5"/>
                                <TextBox x:Name="PickupAddressTextBox" Height="40" Margin="0,0,0,15" Padding="10"/>

                                <TextBlock Text="Адрес доставки" Foreground="#7F8C8D" Margin="0,5"/>
                                <TextBox x:Name="DeliveryAddressTextBox" Height="40" Margin="0,0,0,15" Padding="10"/>

                                <TextBlock Text="Расстояние (км)" Foreground="#7F8C8D" Margin="0,5"/>
                                <TextBox x:Name="DistanceTextBox" Height="40" Margin="0,0,0,15" Padding="10"/>
                            </StackPanel>

                            <!-- Правая колонка -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="📦 Данные о грузе" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                                <TextBlock Text="Тип груза" Foreground="#7F8C8D" Margin="0,5"/>
                                <ComboBox x:Name="CargoTypeCombo" Height="40" Margin="0,0,0,15"/>

                                <TextBlock Text="Наименование груза" Foreground="#7F8C8D" Margin="0,5"/>
                                <TextBox x:Name="CargoNameTextBox" Height="40" Margin="0,0,0,15" Padding="10"/>

                                <TextBlock Text="Вес груза (кг)" Foreground="#7F8C8D" Margin="0,5"/>
                                <TextBox x:Name="WeightTextBox" Height="40" Margin="0,0,0,15" Padding="10"/>

                                <!-- Выбор транспорта -->
                                <TextBlock Text="Транспортное средство" Foreground="#7F8C8D" Margin="0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SelectedVehicleText" Grid.Column="0" Height="40" 
                                             Padding="10" IsReadOnly="True" Background="#F8F9FA"/>
                                    <Button x:Name="SelectVehicleButton" Grid.Column="1" Content="🚛 Выбрать" 
                                            Click="SelectVehicleButton_Click" Width="90" Height="40" 
                                            Margin="10,0,0,0" Background="#3498DB" Foreground="White"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Кнопки -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                            <Button x:Name="CalculateButton" Content="💰 Рассчитать стоимость" Background="#3498DB" Foreground="White" 
                                    Click="CalculateButton_Click" Width="180" Height="40" Margin="5"/>
                            <Button x:Name="SubmitButton" Content="✅ Оформить заказ" Background="#27AE60" Foreground="White" 
                                    Click="SubmitButton_Click" Width="160" Height="40" Margin="5"/>
                            <Button x:Name="ClearButton" Content="🗑 Очистить" Background="#95A5A6" Foreground="White" 
                                    Click="ClearButton_Click" Width="120" Height="40" Margin="5"/>
                        </StackPanel>

                        <!-- Результат расчета -->
                        <Border x:Name="PriceResultPanel" Grid.Row="2" Background="#E8F8F5" CornerRadius="10" Padding="15" Margin="0,20,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💰" FontSize="24"/>
                                <TextBlock x:Name="PriceText" FontSize="24" FontWeight="Bold" Foreground="#27AE60" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Заголовок списка заказов -->
                <TextBlock Text="📋 Мои заказы" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                <!-- Список заказов -->
                <DataGrid x:Name="OrdersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="350"
                          SelectionChanged="OrdersDataGrid_SelectionChanged"
                          Background="White" AlternatingRowBackground="#F9F9F9"
                          FontSize="13" Margin="0,10,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ заказа" Binding="{Binding OrderNumber}" Width="110"/>
                        <DataGridTextColumn Header="Откуда" Binding="{Binding PickupAddress}" Width="200"/>
                        <DataGridTextColumn Header="Куда" Binding="{Binding DeliveryAddress}" Width="200"/>
                        <DataGridTextColumn Header="Груз" Binding="{Binding Cargo.Name}" Width="130"/>
                        <DataGridTextColumn Header="Транспорт" Binding="{Binding Vehicle.PlateNumber}" Width="110"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=' {0:C}'}" Width="100"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status.StatusName}" Width="100"/>
                        <DataGridTemplateColumn Header="Действия" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Подробнее" Tag="{Binding OrderID}" Click="ViewOrderDetails_Click" 
                                                Width="90" Margin="2" Background="#3498DB" Foreground="White" 
                                                FontSize="12" Padding="5"/>
                                        <Button Content="Удалить" Tag="{Binding OrderID}" Click="DeleteOrder_Click" 
                                                Width="70" Margin="2" Background="#E74C3C" Foreground="White" 
                                                FontSize="12" Padding="5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Если нет заказов -->
                <TextBlock x:Name="NoOrdersText" Text="📭 У вас пока нет заказов. Оформите первый заказ выше!" 
                           FontSize="14" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,50,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>