<Window x:Class="CargoTransportation.Views.ClientOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📝 Оформление заказа" Height="650" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📝 Оформление заказа" 
                   FontSize="24" FontWeight="Bold" Foreground="#2C3E50"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#E8F8F5" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold">
                    <Run Text="{Binding Vehicle.Brand}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding Vehicle.Model}"/>
                </TextBlock>
                <TextBlock Foreground="#7F8C8D" Margin="0,5,0,0">
                    <Run Text="Госномер: "/><Run Text="{Binding Vehicle.PlateNumber}"/>
                </TextBlock>
                <TextBlock Foreground="#7F8C8D">
                    <Run Text="Грузоподъемность: "/><Run Text="{Binding Vehicle.LoadCapacity}"/><Run Text=" кг"/>
                </TextBlock>
                <TextBlock Foreground="#7F8C8D">
                    <Run Text="Год выпуска: "/><Run Text="{Binding Vehicle.Year}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="📍 Адрес погрузки" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,5"/>
                <TextBox x:Name="PickupAddressTextBox" Height="40" Margin="0,5,0,15" Padding="10"/>

                <TextBlock Text="📍 Адрес доставки" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,5"/>
                <TextBox x:Name="DeliveryAddressTextBox" Height="40" Margin="0,5,0,15" Padding="10"/>

                <TextBlock Text="📏 Расстояние (км)" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,5"/>
                <TextBox x:Name="DistanceTextBox" Height="40" Margin="0,5,0,15" Padding="10"/>

                <TextBlock Text="📦 Тип груза" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,5"/>
                <ComboBox x:Name="CargoTypeCombo" Height="40" Margin="0,5,0,15"/>

                <TextBlock Text="📦 Наименование груза" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,5"/>
                <TextBox x:Name="CargoNameTextBox" Height="40" Margin="0,5,0,15" Padding="10"/>

                <TextBlock Text="⚖️ Вес груза (кг)" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,5"/>
                <TextBox x:Name="WeightTextBox" Height="40" Margin="0,5,0,15" Padding="10"/>

                <Border x:Name="PriceResultPanel" Background="#E8F8F5" CornerRadius="10" Padding="15" Margin="0,15,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="PriceText" FontSize="18" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="CalculateButton" Content="💰 Рассчитать стоимость" 
                    Click="CalculateButton_Click" Width="180" Height="40" Margin="5"
                    Background="#3498DB" Foreground="White"/>
            <Button x:Name="SubmitButton" Content="✅ Оформить заказ" 
                    Click="SubmitButton_Click" Width="160" Height="40" Margin="5"
                    Background="#27AE60" Foreground="White"/>
            <Button x:Name="CancelButton" Content="❌ Отмена" 
                    Click="CancelButton_Click" Width="120" Height="40" Margin="5"
                    Background="#95A5A6" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>