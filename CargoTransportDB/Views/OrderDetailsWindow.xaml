<Window x:Class="CargoTransportation.Views.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заказа" Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="📋 ИНФОРМАЦИЯ О ЗАКАЗЕ" 
                   FontSize="20" FontWeight="Bold" Foreground="#2C3E50" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Номер заказа:" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock x:Name="OrderNumberText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="14"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата создания:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock x:Name="OrderDateText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,10,0,0"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Статус:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <ComboBox x:Name="StatusCombo" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,10,0,0"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Адрес погрузки:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <TextBox x:Name="PickupAddressText" Grid.Row="4" Grid.Column="1" Height="30" Margin="0,10,0,0" Padding="5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Адрес доставки:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <TextBox x:Name="DeliveryAddressText" Grid.Row="5" Grid.Column="1" Height="30" Margin="0,10,0,0" Padding="5"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Расстояние (км):" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <TextBox x:Name="DistanceText" Grid.Row="6" Grid.Column="1" Height="30" Margin="0,10,0,0" Padding="5"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Цена:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <TextBox x:Name="PriceText" Grid.Row="7" Grid.Column="1" Height="30" Margin="0,10,0,0" Padding="5"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Груз:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <TextBox x:Name="CargoNameText" Grid.Row="8" Grid.Column="1" Height="30" Margin="0,10,0,0" Padding="5" IsReadOnly="True" Background="#F0F0F0"/>

        <Border Grid.Row="9" Grid.ColumnSpan="2" Height="1" Background="#BDC3C7" Margin="0,20,0,20"/>

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="SaveButton" Content="💾 Сохранить изменения" Click="SaveButton_Click" 
                    Width="150" Height="40" Margin="5" Background="#27AE60" Foreground="White"/>
            <Button x:Name="DeleteButton" Content="🗑 Удалить заказ" Click="DeleteButton_Click" 
                    Width="150" Height="40" Margin="5" Background="#E74C3C" Foreground="White"/>
            <Button x:Name="CancelButton" Content="❌ Закрыть" Click="CancelButton_Click" 
                    Width="120" Height="40" Margin="5" Background="#95A5A6" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>