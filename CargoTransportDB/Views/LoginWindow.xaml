<Window x:Class="CargoTransportation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="637" Width="500" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    
    <Grid Background="#2C3E50" Margin="0,0,0,3">
        <Border Background="White" CornerRadius="10" Width="420" Height="578" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="30">
                
                <!-- Заголовок -->
                <TextBlock Text="🚚" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Грузоперевозки" FontSize="24" FontWeight="Bold" 
                          HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Система управления" FontSize="14" 
                          HorizontalAlignment="Center" Margin="0,0,0,25"
                          Foreground="#7F8C8D"/>
                
                <Border Height="2" Background="#3498DB" Margin="0,0,0,20" CornerRadius="1"/>
                
                <TextBlock Text="Вход в систему" FontSize="16" FontWeight="SemiBold" 
                          HorizontalAlignment="Center" Margin="0,0,0,20"
                          Foreground="#2C3E50"/>
                
                <!-- Логин -->
                <TextBlock Text="Логин" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#2C3E50"/>
                <TextBox x:Name="UsernameTextBox" Margin="0,0,0,15" Padding="12" 
                        FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"
                        Background="#F8F9FA"/>
                
                <!-- Пароль -->
                <TextBlock Text="Пароль" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#2C3E50"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,15" Padding="12" 
                            FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1"
                            Background="#F8F9FA"/>
                
                <!-- Ошибка -->
                <TextBlock x:Name="ErrorTextBlock" Foreground="#E74C3C" Margin="0,0,0,10" 
                          Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                          HorizontalAlignment="Center"/>
                
                <!-- Кнопка Войти -->
                <Button x:Name="LoginButton" Content="ВОЙТИ" Background="#3498DB" 
                       Foreground="White" FontSize="14" FontWeight="Bold" 
                       Padding="12" Margin="0,5,0,5" Height="45"
                       Click="LoginButton_Click" Cursor="Hand" BorderThickness="0"/>
                
                <!-- Разделитель -->
                <Grid Margin="0,10,0,10">
                    <Border Height="1" Background="#BDC3C7" VerticalAlignment="Center"/>
                    <TextBlock Text="или" Background="White" Width="30" HorizontalAlignment="Center" 
                              Foreground="#7F8C8D" TextAlignment="Center"/>
                </Grid>
                
                <!-- Кнопка Регистрация -->
                <Button x:Name="RegisterButton" Content="ЗАРЕГИСТРИРОВАТЬСЯ" 
                       Background="#27AE60" Foreground="White" FontSize="14" FontWeight="Bold"
                       Padding="12" Height="45" Click="RegisterButton_Click" Cursor="Hand"
                       BorderThickness="0" Margin="0,0,0,10"/>
                
                <!-- Кнопка Тест (диагностика) -->
                
                <!-- Подсказка -->
                <TextBlock FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0" 
                          Foreground="#95A5A6">
                    <Run Text="Тестовый вход: " FontWeight="Bold"/>
                    <Run Text="admin / admin" Foreground="#3498DB"/>
                </TextBlock>
                
            </StackPanel>
        </Border>
    </Grid>
</Window>