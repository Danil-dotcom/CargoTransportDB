<Window x:Class="CargoTransportation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="500" Width="500" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Grid Background="#2C3E50" Margin="0,-31,-18,-16">
        <Border Background="White" CornerRadius="10" Width="420" Height="490" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="25">
                <!-- Заголовок -->
                <TextBlock Text="🚚" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Грузоперевозки" FontSize="24" FontWeight="Bold" 
                          HorizontalAlignment="Center" Margin="0,10,0,5"/>
                <TextBlock Text="Система управления" FontSize="14" 
                          HorizontalAlignment="Center" Margin="0,0,0,25"
                          Foreground="#7F8C8D"/>

                <TextBlock Text="Вход в систему" FontSize="16" FontWeight="SemiBold" 
                          HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <!-- Поле Логин -->
                <TextBlock Text="Логин:" Margin="0,5,0,0" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameTextBox" Margin="0,2,0,5" Padding="12" 
                        FontSize="14" MaxLength="50"
                        TextChanged="UsernameTextBox_TextChanged"/>

                <!-- Поле Пароль -->
                <TextBlock Text="Пароль:" Margin="0,5,0,0" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,2,0,5" Padding="12" 
                            FontSize="14" PasswordChanged="PasswordBox_PasswordChanged"/>

                <!-- Ошибка -->
                <TextBlock x:Name="ErrorTextBlock" Foreground="#E74C3C" Margin="0,5" 
                          Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"/>

                <!-- Кнопка Войти -->
                <Button x:Name="LoginButton" Content="Войти" Background="#3498DB" 
                       Foreground="White" FontSize="14" Padding="12" Margin="0,15,0,5"
                       Click="LoginButton_Click" Cursor="Hand" IsEnabled="False">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3498DB"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Кнопка Регистрация -->
                <Button x:Name="RegisterButton" Content="Зарегистрироваться" 
                       Background="#27AE60" Foreground="White" FontSize="14" 
                       Padding="12" Click="RegisterButton_Click" Cursor="Hand"
                       BorderThickness="0" Margin="0,5">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#27AE60"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Подсказка -->
                <TextBlock Text="Нет аккаунта? Нажмите 'Зарегистрироваться'" 
                          FontSize="11" HorizontalAlignment="Center" 
                          Margin="0,15,0,0" Foreground="#7F8C8D"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>