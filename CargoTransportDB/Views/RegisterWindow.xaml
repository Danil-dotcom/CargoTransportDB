<Window x:Class="CargoTransportation.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="803" Width="885" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Grid Background="#2C3E50" Margin="0,10,10,-6">
        <Border Background="White" CornerRadius="10" Width="470" Height="612" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="25">
                <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Регистрация нового пользователя" FontSize="20" FontWeight="Bold" 
                          HorizontalAlignment="Center" Margin="0,10,0,20"/>

                <!-- Логин -->
                <TextBlock Text="Логин:" Margin="0,5,0,0" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameTextBox" Margin="0,2,0,5" Padding="10" FontSize="13"
                         MaxLength="50" TextChanged="UsernameTextBox_TextChanged"/>
                <TextBlock x:Name="UsernameError" Foreground="#E74C3C" FontSize="10" 
                          Visibility="Collapsed" Margin="5,0,0,0"/>

                <!-- Email -->
                <TextBlock Text="Email:" Margin="0,5,0,0" FontWeight="SemiBold"/>
                <TextBox x:Name="EmailTextBox" Margin="0,2,0,5" Padding="10" FontSize="13"
                         MaxLength="100" TextChanged="EmailTextBox_TextChanged"/>
                <TextBlock x:Name="EmailError" Foreground="#E74C3C" FontSize="10" 
                          Visibility="Collapsed" Margin="5,0,0,0"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон:" Margin="0,5,0,0" FontWeight="SemiBold"/>
                <TextBox x:Name="PhoneTextBox" Margin="0,2,0,5" Padding="10" FontSize="13"
                         MaxLength="20" TextChanged="PhoneTextBox_TextChanged"/>
                <TextBlock x:Name="PhoneError" Foreground="#E74C3C" FontSize="10" 
                          Visibility="Collapsed" Margin="5,0,0,0"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль:" Margin="0,5,0,0" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,2,0,5" Padding="10" FontSize="13"
                            PasswordChanged="PasswordBox_PasswordChanged"/>
                <TextBlock x:Name="PasswordError" Foreground="#E74C3C" FontSize="10" 
                          Visibility="Collapsed" Margin="5,0,0,0"/>

                <!-- Подтверждение пароля -->
                <TextBlock Text="Подтверждение пароля:" Margin="0,5,0,0" FontWeight="SemiBold"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,2,0,5" Padding="10" FontSize="13"
                            PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="ConfirmPasswordError" Foreground="#E74C3C" FontSize="10" 
                          Visibility="Collapsed" Margin="5,0,0,0"/>

                <!-- Общая ошибка -->
                <TextBlock x:Name="ErrorTextBlock" Foreground="#E74C3C" Margin="0,10" 
                          Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"/>

                <!-- Кнопки -->
                <Button x:Name="RegisterButton" Content="Зарегистрироваться" 
                       Background="#27AE60" Foreground="White" FontSize="14" 
                       Padding="12" Margin="0,10" Click="RegisterButton_Click"
                       Cursor="Hand" IsEnabled="False" Height="28">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#27AE60"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Отмена" Click="CancelButton_Click" 
                       Background="#95A5A6" Foreground="White" FontSize="14" Padding="10"
                       Cursor="Hand" BorderThickness="0" Height="33">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="#95A5A6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>