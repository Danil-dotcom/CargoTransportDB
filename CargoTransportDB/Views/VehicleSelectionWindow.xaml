<Window x:Class="CargoTransportation.Views.VehicleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🚛 Выбор транспортного средства" Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Конвертер для статуса -->
        <Style x:Key="StatusStyle" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Available">
                    <Setter Property="Background" Value="#27AE60"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="OnRoute">
                    <Setter Property="Background" Value="#F39C12"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Repair">
                    <Setter Property="Background" Value="#E74C3C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Выберите транспортное средство" 
                   FontSize="22" FontWeight="Bold" Foreground="#2C3E50"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Список транспорта -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="VehiclesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="10" Margin="0,0,0,10" Padding="10"
                                BorderBrush="#BDC3C7" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- КАРТИНКА -->
                                <Border Grid.Column="0" Width="90" Height="90" CornerRadius="8" 
                                        Background="#F0F0F0" Margin="0,0,15,0">
                                    <Image Width="80" Height="80" Stretch="Uniform" Source="{Binding ImagePath}"/>
                                </Border>

                                <!-- ИНФОРМАЦИЯ -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="16" FontWeight="Bold">
                                        <Run Text="{Binding Brand}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Model}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#7F8C8D" Margin="0,5,0,0">
                                        <Run Text="📋 Госномер: "/><Run Text="{Binding PlateNumber}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#7F8C8D">
                                        <Run Text="⚖️ Грузоподъемность: "/><Run Text="{Binding LoadCapacity}"/><Run Text=" кг"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#7F8C8D">
                                        <Run Text="📅 Год: "/><Run Text="{Binding Year}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- СТАТУС И КНОПКА -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border CornerRadius="15" Padding="10,5" Margin="0,0,0,10"
                                            Background="{Binding Status, Converter={StaticResource StatusColorConverter}}">
                                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="White"/>
                                    </Border>
                                    <Button Content="✅ Выбрать" 
                                            Tag="{Binding VehicleID}"
                                            Click="SelectVehicle_Click"
                                            Width="100" Height="35"
                                            Background="#27AE60" Foreground="White"
                                            IsEnabled="{Binding Status, Converter={StaticResource StatusEnabledConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Кнопка отмены -->
        <Button Grid.Row="2" Content="❌ Отмена" Click="CancelButton_Click" 
                Width="120" Height="35" Margin="0,15,0,0"
                Background="#95A5A6" Foreground="White" HorizontalAlignment="Center"/>
    </Grid>
</Window>